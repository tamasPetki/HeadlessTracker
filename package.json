{
  "name": "headless-tracker",
  "version": "0.9.2",
  "description": "MCP server for portfolio tracking across crypto exchanges, on-chain wallets, brokerages, and prediction markets. Query your portfolio from any MCP-compatible AI host (Claude Desktop, Claude Code, Cursor, ChatGPT).",
  "type": "module",
  "module": "src/mcp/server.ts",
  "bin": {
    "headless-tracker": "./bin/headless-tracker.ts"
  },
  "scripts": {
    "start": "bun run src/mcp/server.ts",
    "setup": "bun run bin/headless-tracker.ts setup",
    "test": "bun test --timeout=15000",
    "test:watch": "bun test --watch --timeout=15000",
    "typecheck": "bun --bun tsc --noEmit",
    "prepublishOnly": "bun test --timeout=15000 && bun --bun tsc --noEmit"
  },
  "files": [
    "bin/",
    "src/",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "portfolio",
    "crypto",
    "stocks",
    "polymarket",
    "bybit",
    "metamask",
    "ibkr",
    "claude",
    "ai-tools"
  ],
  "author": {
    "name": "Tomi (PietScarlet)",
    "url": "https://bulltrapp.com"
  },
  "homepage": "https://github.com/PietScarlet/headless-tracker",
  "repository": {
    "type": "git",
    "url": "https://github.com/PietScarlet/headless-tracker.git"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@napi-rs/keyring": "^1.1.6",
    "bybit-api": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
